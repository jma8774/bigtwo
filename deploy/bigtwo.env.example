# Production env for the bigtwo backend. Installed at /etc/bigtwo.env
# (chmod 640, root:bigtwo). Loaded by systemd via EnvironmentFile=.
#
# Do NOT commit a populated copy of this file. Only this .example lives in git.

# Backend listens on this port; Nginx proxies /socket.io/ + /healthz here.
PORT=3002

# Where the logger writes daily files. Must exist and be writable by the
# `bigtwo` user. The systemd unit's ReadWritePaths= must include this path.
BIGTWO_LOG_DIR=/var/log/bigtwo

# debug | info | warn | error
BIGTWO_LOG_LEVEL=info

# Safety: the dev/test default is "1" (auto-pass humans after 250ms so one
# tester can drive a full table). PROD MUST EXPLICITLY SET 0.
BIGTWO_AUTO_PASS_HUMANS=0

# Socket.IO CORS. With a single same-origin Nginx proxying both static + ws
# this can stay at the canonical URL.
CORS_ORIGIN=https://bigtwo.cutecalico.com

NODE_ENV=production
